// ---------------------------------------------------------------------------
// types.ts – Frontend UI types (derived from backend DTOs where possible)
// ---------------------------------------------------------------------------

/** Matches GroupMemberResponse from the backend, with UI extras derived client-side */
export type Member = {
  id: number          // userId from backend
  membershipId?: number
  name: string
  email?: string
  initials: string    // derived from name
  points: number      // sum from chores (computed client-side)
  chores: number      // count of chores (computed client-side)
  color: string       // derived deterministically from userId
  isAdmin?: boolean   // role === 'OWNER' or 'ADMIN'
  role?: 'OWNER' | 'ADMIN' | 'MEMBER'
  displayTitle?: string
  todayChores?: number
  todayCompleted?: number
}

/** UI wrapper around GroupResponse from the backend */
export type Household = {
  id: number
  name: string
  description?: string
  ownerId: number
  inviteCode?: string
  emoji: string       // derived from name / default
  isAdmin: boolean    // ownerId === currentUserId
  members: Member[]   // fetched separately
  createdAt?: string
}

// ---- helpers to derive UI fields from backend data ------------------------

const MEMBER_COLORS = [
  '#087769', '#d8865b', '#7468ad', '#4b87a8',
  '#c0584f', '#5a9e6f', '#b07cc6', '#d4a843',
  '#3d8b8b', '#e07070',
]

export function deriveInitials(name: string): string {
  const parts = name.trim().split(/\s+/)
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
  }
  return name.slice(0, 2).toUpperCase()
}

export function deriveColor(userId: number): string {
  return MEMBER_COLORS[userId % MEMBER_COLORS.length]
}

const HOUSEHOLD_EMOJIS = ['🏡', '🏠', '🎓', '💼', '🌿', '🌈']

export function deriveEmoji(groupId: number): string {
  return HOUSEHOLD_EMOJIS[groupId % HOUSEHOLD_EMOJIS.length]
}
